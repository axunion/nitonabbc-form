    "@vitest/coverage-v8": "^5.0.0",
    "happy-dom": "^20.14.0",
    "lefthook": "^2.1.12",
    "playwright": "^1.63.0",
    "typescript": "~6.0.3",
    "vite-plugin-solid": "^2.11.14",
    "vitest": "^5.0.0"
